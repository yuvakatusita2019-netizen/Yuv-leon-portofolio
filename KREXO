<script>

// =====================================
// KREXO CONFIGURATION
// =====================================

const PHONE = "6281436119855";
const EMAIL = "yuvandleon2512@gmail.com";

// GANTI URL PREVIEW DI SINI

const PREVIEW = {
  dailyProgram: "MASUKKAN_URL_VIDEO_PROGRAM_HARIAN",
  businessProgram: "MASUKKAN_URL_VIDEO_PROGRAM_BISNIS",
  meme: "MASUKKAN_URL_VIDEO_EDIT_MEME",
  vfx: "MASUKKAN_URL_VIDEO_VFX",
  infographic: "MASUKKAN_URL_GAMBAR_INFOGRAFIS",
  poster: "MASUKKAN_URL_GAMBAR_POSTER",
  ppt: "MASUKKAN_URL_VIDEO_PREVIEW_PPT"
};

// Layanan yang sedang dipilih
let selectedOrderService = "";

// =====================================
// NAVIGATION
// =====================================

function showPage(pageId) {
  const targetPage = document.getElementById(pageId);

  if (!targetPage) return;

  document.querySelectorAll('.page').forEach(page => {
    page.classList.remove('active');
  });

  targetPage.classList.add('active');

  document.querySelectorAll('.nav-links a').forEach(link => {
    link.classList.remove('active');

    if (link.getAttribute('href') === '#' + pageId) {
      link.classList.add('active');
    }
  });

  document.getElementById('navLinks').classList.remove('open');

  window.scrollTo({ top: 0, behavior: 'smooth' });

  setTimeout(revealElements, 100);
}

// =====================================
// MOBILE MENU
// =====================================

function toggleMenu() {
  document.getElementById('navLinks').classList.toggle('open');
}

// =====================================
// PREVIEW SYSTEM
// =====================================

function openPreview(title, type, url) {
  const modal = document.getElementById('previewModal');
  const stage = document.getElementById('previewStage');

  document.getElementById('previewTitle').textContent = title;
  stage.innerHTML = '';

  if (!url || url.startsWith('MASUKKAN_URL_')) {
    stage.innerHTML = `
      <div style="padding:30px;text-align:center">
        <div style="font-size:45px;color:var(--lime)">↗</div>
        <h3 style="margin:15px 0">Preview belum tersedia</h3>
        <p style="color:var(--muted);font-size:12px;line-height:1.8">
          Tambahkan URL video atau gambar pada bagian PREVIEW
          CONFIGURATION di dalam JavaScript.
        </p>
      </div>
    `;
  } else if (type === 'video') {
    const video = document.createElement('video');

    video.src = url;
    video.controls = true;
    video.playsInline = true;
    video.preload = 'metadata';

    video.onerror = function() {
      stage.innerHTML = `
        <p style="padding:25px;text-align:center;color:var(--muted)">
          Video tidak dapat dimuat. Periksa URL video yang digunakan.
        </p>
      `;
    };

    stage.appendChild(video);
  } else {
    const img = document.createElement('img');

    img.src = url;
    img.alt = title;

    img.onerror = function() {
      stage.innerHTML = `
        <p style="padding:25px;text-align:center;color:var(--muted)">
          Gambar tidak dapat dimuat. Periksa URL gambar yang digunakan.
        </p>
      `;
    };

    stage.appendChild(img);
  }

  modal.classList.add('active');
  document.body.style.overflow = 'hidden';
}

function closePreview() {
  const modal = document.getElementById('previewModal');
  const stage = document.getElementById('previewStage');

  const video = stage.querySelector('video');

  if (video) {
    video.pause();
    video.removeAttribute('src');
    video.load();
  }

  modal.classList.remove('active');
  document.body.style.overflow = '';
}

function outsidePreview(event) {
  if (event.target.id === 'previewModal') {
    closePreview();
  }
}

// =====================================
// ORDER SYSTEM
// =====================================

// Buka pilihan metode pemesanan
function orderNow(service) {
  selectedOrderService = service;

  document.getElementById('selectedService').textContent =
    service;

  document.getElementById('orderModal').classList.add('active');

  document.body.style.overflow = 'hidden';
}

// Tutup pilihan metode
function closeOrder() {
  document.getElementById('orderModal').classList.remove('active');
  document.body.style.overflow = '';
}

// Klik area luar modal untuk menutup
function outsideOrder(event) {
  if (event.target.id === 'orderModal') {
    closeOrder();
  }
}

// =====================================
// ORDER VIA WHATSAPP
// =====================================

function orderViaWhatsApp() {
  const message =
    `Halo KREXO! Saya tertarik memesan layanan: ${selectedOrderService}. ` +
    `Boleh saya bertanya lebih lanjut mengenai harga dan proses pengerjaannya?`;

  const whatsappURL =
    "https://wa.me/" + PHONE +
    "?text=" + encodeURIComponent(message);

  window.open(whatsappURL, "_blank");

  closeOrder();
}

// =====================================
// ORDER VIA GMAIL
// =====================================

function orderViaGmail() {
  const subject =
    `Pemesanan Layanan KREXO - ${selectedOrderService}`;

  const body =
    `Halo KREXO!\n\n` +
    `Saya tertarik memesan layanan berikut:\n` +
    `${selectedOrderService}\n\n` +
    `Saya ingin bertanya lebih lanjut mengenai harga, ` +
    `detail pengerjaan, dan proses pemesanan.\n\n` +
    `Terima kasih.`;

  const gmailURL =
    "mailto:" + EMAIL +
    "?subject=" + encodeURIComponent(subject) +
    "&body=" + encodeURIComponent(body);

  window.location.href = gmailURL;

  closeOrder();
}

// =====================================
// CONTACT WHATSAPP
// =====================================

function contactWhatsApp() {
  const message =
    "Halo KREXO! Saya ingin bertanya mengenai layanan yang tersedia.";

  window.open(
    "https://wa.me/" + PHONE +
    "?text=" + encodeURIComponent(message),
    "_blank"
  );
}

// =====================================
// COPY GMAIL
// =====================================

function copyEmail() {
  if (navigator.clipboard && window.isSecureContext) {
    navigator.clipboard.writeText(EMAIL)
      .then(() => alert("Alamat Gmail berhasil disalin: " + EMAIL))
      .catch(() => fallbackCopyEmail());
  } else {
    fallbackCopyEmail();
  }
}

function fallbackCopyEmail() {
  const textArea = document.createElement("textarea");

  textArea.value = EMAIL;
  textArea.style.position = "fixed";
  textArea.style.opacity = "0";

  document.body.appendChild(textArea);
  textArea.select();

  try {
    document.execCommand("copy");
    alert("Alamat Gmail berhasil disalin: " + EMAIL);
  } catch (error) {
    alert("Silakan salin email secara manual: " + EMAIL);
  }

  document.body.removeChild(textArea);
}

// =====================================
// KEYBOARD ESCAPE
// =====================================

document.addEventListener('keydown', function(event) {
  if (event.key === 'Escape') {
    closePreview();
    closeOrder();
  }
});

// =====================================
// REVEAL ANIMATION
// =====================================

function revealElements() {
  const elements = document.querySelectorAll(
    '.page.active .service-card, ' +
    '.page.active .catalog-card, ' +
    '.page.active .stat'
  );

  elements.forEach((element, index) => {
    element.classList.remove('reveal', 'show');

    void element.offsetWidth;

    element.classList.add('reveal');

    setTimeout(() => {
      element.classList.add('show');
    }, index * 80);
  });
}

window.addEventListener('load', revealElements);

</script>

